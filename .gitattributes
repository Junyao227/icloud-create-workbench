# 统一行尾：仓库内一律 LF，避免 Windows(CRLF) 与 Linux(LF) 检出后互相显示为全文件修改
* text=auto eol=lf

# 显式声明的文本类型
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf

# 二进制，禁止任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   -text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.db    binary
